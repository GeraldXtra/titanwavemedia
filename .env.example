# Settings for the Titan Wave Media website.
# On your computer: copy this file to .env.local and fill in what you have.
# On Vercel: add the same names under Project, Settings, Environment Variables.
# All of them are optional. The site runs without them, and each feature switches on when its key is added.

# The site assistant's AI model. Get a key at https://console.anthropic.com under Settings, API Keys.
ANTHROPIC_API_KEY=

# Saves messages, sign ups and assistant conversations. Supabase dashboard: Project Settings, Data API, Project URL.
SUPABASE_URL=

# Supabase dashboard: Project Settings, API Keys, the secret (service_role) key. Server only, keep it private.
SUPABASE_SERVICE_KEY=

# Emails you each new contact message. Get a key at https://resend.com under API Keys.
RESEND_API_KEY=

# The inbox for contact messages. The company address is suggested below. Until a domain is verified
# in Resend, this must be the email you used to sign up to Resend, or the messages will not send.
CONTACT_TO_EMAIL=titanwavemedia@proton.me

# The WhatsApp number behind every "Chat on WhatsApp" link: digits only, with the country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=2347064094004

# Optional extras:
# The site's address for shared links and the sitemap, if Vercel's own address is not the one you use.
# SITE_URL=https://www.example.com
# The sender of contact emails once your domain is verified in Resend (until then onboarding@resend.dev is used).
# CONTACT_FROM_EMAIL=Titan Wave Media <hello@example.com>
