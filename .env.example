# Settings for the Titan Wave Media website.
# On your computer: copy this file to .env.local and fill in what you have.
# On Vercel: add the same names under Project, Settings, Environment Variables.
# The public site runs without any of them, and each feature switches on when its keys are added.

# The AI behind the site assistant and Wave Assist. Get a key at https://console.anthropic.com under Settings, API Keys.
ANTHROPIC_API_KEY=

# Saves messages, sign ups and assistant conversations. Supabase dashboard: Project Settings, Data API, Project URL.
SUPABASE_URL=

# Supabase dashboard: Project Settings, API Keys, the secret (service_role) key. Server only, keep it private.
SUPABASE_SERVICE_KEY=

# Emails you each new contact message. Get a key at https://resend.com under API Keys.
RESEND_API_KEY=

# The inbox for contact messages. The company address is suggested below. Until a domain is verified
# in Resend, this must be the email you used to sign up to Resend, or the messages will not send.
CONTACT_TO_EMAIL=titanwavemedia@proton.me

# The company email shown on the website and used as the reply address of our emails. Optional: titanwavemedia@proton.me without it.
NEXT_PUBLIC_SITE_EMAIL=titanwavemedia@proton.me

# The WhatsApp number behind every "Chat on WhatsApp" link: digits only, with the country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=2347064094004

# Accounts, the client console and Pay with Titan Wave. Until every one of the settings below
# (except NEXT_PUBLIC_GOOGLE_SIGNIN) is filled in, the public site works as before and /console
# shows "Accounts aren't switched on yet". SUPABASE_SERVICE_KEY and RESEND_API_KEY above are needed too.
# Spaces, quotes around a value and a slash at the end of an address are ignored. The check runs on
# every request, and the server log names any setting that is missing (never its value).
# To check them: GET /api/status/accounts with the header "Authorization: Bearer <your CRON_SECRET>".

# The same address as SUPABASE_URL, for signing in. Supabase dashboard: Project Settings, Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard: Project Settings, API Keys, the publishable key (it starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paystack dashboard: Settings, API Keys and Webhooks, the secret key. Server only. sk_test_ keys mean test mode.
PAYSTACK_SECRET_KEY=

# Paystack dashboard: Settings, API Keys and Webhooks, the public key (pk_test_ or pk_live_).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# The owner's email: this person sees Team view and can add or remove team members.
OWNER_EMAIL=titanwavemedia@proton.me

# A long random secret that protects the daily job. Vercel sends it with every cron call.
CRON_SECRET=

# "on" shows Continue with Google on the sign in page (set up Google in Supabase first). Anything else hides it.
NEXT_PUBLIC_GOOGLE_SIGNIN=off

# Optional extras:
# The site's address for shared links, the sitemap and every link in an email. Set it to your live
# address, so email links never point anywhere else.
# SITE_URL=https://www.example.com
# The sender of every email once your domain is verified in Resend (until then onboarding@resend.dev is used).
# CONTACT_FROM_EMAIL=Titan Wave Media <hello@example.com>
# EMAIL_LOG_ONLY=1 writes emails to the server log instead of sending them, for checks.
# Wave Assist's AI model. Optional: without it, Wave Assist uses claude-haiku-4-5-20251001.
# ASSIST_MODEL=claude-haiku-4-5-20251001
# The most AI answers Wave Assist gives in one Lagos day, across every business. Optional: 1000 without it.
# ASSIST_DAILY_LIMIT=1000
